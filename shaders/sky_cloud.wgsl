// sky_cloud.wgsl — 空＋体積雲の背景パス。
//
// 出自: portfolio-3d/shaders/unkai.wgsl（雲海）。実カメラを受ける汎用の背景へ移植した。
// 移植で変えたのは3点だけで、雲の造形（逆転層で雲頂を揃える／Beer-Lambert の透過積分／
// Henyey-Greenstein 前方散乱／powder／高度で形が変わる密度）は原本のまま:
//   1. yaw/pitch でカメラを組む → **基底ベクトル直渡し**（呼び元の座標系に依存しない）
//   2. 自機/対向機と翼端渦を撤去（ここに飛行機は居ない）
//   3. 自前の ACES トーンマップを撤去し **線形HDRのまま出す**
//      ★ seimei はポストプロセスで一括 tonemap する。ここで掛けると二重処理で真っ白になる。
//
// ⚠ 単体で完結している。`_common.wgsl` も `_pf_common.wgsl` も貼らないこと。
//
// ── なぜ雲か ────────────────────────────────────────
//
// ポートフォリオ(`cyber_night.wgsl`)には、鏡面のウユニと、一日のサイクルと、
// オーロラと、天の川と、流れ星と、鳥の群れが在る。全部**実在しない**ので、
// 原本に負けようがない＝出来た物がそのまま正解になる。強いのはそこ。
//
// そしてあの世界に**無い**のが「体積」。空は最後まで「見上げる絵」で、
// 雲の中には入れない。ウユニは平面。全部「地面に立って空を見る」。
//
// 雲は光が**中で散る**から美しい。だから絵として貼った瞬間に死ぬ。
// ＝ポートフォリオの手が届いていない唯一の場所で、しかも原本が無い。
//
// ── ⚠ 実物に似せに行かないこと ─────────────────────
//
// この session で3回負けた（解体現場・曜変天目×2）。全部、**写真がある物**を
// シェーダで再現しに行った。頭の中の実物と比較されるので、8割の出来は
// 「8割の美しさ」ではなく「**出来損ない**」になる。曜変が「キモい」と言われたのはそれ。
// 雲は誰も「正しい雲」の写真を持っていない。だから作った物が雲になる。
//
// ── 美しさの手順 ────────────────────────────────────
//
//   1. 光は**中で散る**。表面を塗らない。透過率を積分する（Beer-Lambert）
//   2. 前方散乱（Henyey-Greenstein）。太陽の方を向いた時に縁が銀に光るのはこれ
//   3. 多重散乱。1回散乱だけだと雲の底が真っ黒になる（実物の底は青く明るい）
//   4. powder。雲の縁が暗くなる効果。これが無いと綿菓子になる
//   5. 密度は上下で形が違う。底は平らで、頂は入道雲に膨らむ

struct Un {
    time: f32,
    aspect: f32,
    /// 太陽高度 -1..1。0 が地平（空の色味と星の出方を決める）。⚠ 止めないこと（止まった空は絵）。
    sun_alt: f32,
    /// 雲量バイアス。+で曇り、-で晴れ。
    cover_bias: f32,

    /// カメラ位置（m・Y-up）。
    cam: vec4<f32>,
    /// カメラ基底（正規化済み）。yaw/pitch でなくベクトル直渡し＝呼び元の座標系に依存しない。
    fwd: vec4<f32>,
    rgt: vec4<f32>,
    up: vec4<f32>,
    /// 太陽へ向かう単位ベクトル（Y-up）。地上の陰影と食い違わないよう呼び元と共有する。
    sun: vec4<f32>,
}


@group(0) @binding(0)
var<uniform> u: Un;

struct VOut {
    @builtin(position) position: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

var<private> FULLSCREEN: array<vec2<f32>, 6> = array<vec2<f32>, 6>(
    vec2<f32>(-1.0, -1.0),
    vec2<f32>( 1.0, -1.0),
    vec2<f32>( 1.0,  1.0),
    vec2<f32>(-1.0, -1.0),
    vec2<f32>( 1.0,  1.0),
    vec2<f32>(-1.0,  1.0),
);

@vertex
fn vs_bg(@builtin(vertex_index) vi: u32) -> VOut {
    var out: VOut;
    let pos = FULLSCREEN[vi];
    out.position = vec4<f32>(pos, 0.999, 1.0);
    out.uv = pos * 0.5 + 0.5;
    return out;
}

// ── 雲の層 ──────────────────────────────────────────
//
// ⚠ 単位はメートルのつもりで持つこと。雲を 1.0 スケールで作ると、
//   ノイズの周波数と歩幅が噛み合わなくなって「霧の塊」になる。
//   雲海が美しいのは**でかいから**なので、でかい数字で作る。

/// 雲底。⚠ ここは動かさない。動かすと slab の下限が場所ごとに変わって、
///   march の開始位置を保守的に取れなくなる。
const Y0: f32 = 700.0;

// ── 逆転層 ──────────────────────────────────────────
//
// ⚠ **雲海が雲海に見える理由は、雲頂が平らだから**。
//   実際の雲海は気温の逆転層に頭を押さえられていて、雲頂が数百km に渡って
//   ほぼ同じ高さで揃う。だから「海」に見える。
//
//   一度、雲頂を場所ごとに 1250〜4400m 振った。14km ごとに雲頂が3km上下する
//   ＝それは海ではなく**山脈**で、「全然雲海になってない」と言われた。
//   雲海は、雲頂の**平らさ**が主役。凸凹は主役ではない。

/// 逆転層の高さ（m）。ここで雲が頭打ちになる。
const INVERSION: f32 = 1900.0;
/// 海面のうねり（m）。⚠ 小さいこと。海のうねりであって、山ではない。
const INV_WAVE: f32 = 115.0;
/// 積乱雲が逆転層を**突き破って**伸びる高さ（m）。
/// ⚠ 嵐だけがここまで来る。嵐が特別なのは、蓋を破れるから。
const TOWER_TOP: f32 = 4600.0;
/// slab の上限。塔より上は雲が無い。
const Y_MAX: f32 = TOWER_TOP + 100.0;
/// 消散係数。上げるほど濃く、光が奥へ届かなくなる。
const SIGMA: f32 = 0.055;
/// 追跡の上限距離。⚠ 伸ばすほど遠くの雲が出るが、歩幅も伸びて縞が出る。
const FAR: f32 = 46000.0;

// ── ノイズ ──────────────────────────────────────────

fn hash13(p3: vec3<f32>) -> f32 {
    var p = fract(p3 * 0.1031);
    p = p + dot(p, p.zyx + 31.32);
    return fract((p.x + p.y) * p.z);
}

fn vnoise3(x: vec3<f32>) -> f32 {
    let i = floor(x);
    let f = fract(x);
    let s = f * f * (3.0 - 2.0 * f);
    let n000 = hash13(i + vec3<f32>(0.0, 0.0, 0.0));
    let n100 = hash13(i + vec3<f32>(1.0, 0.0, 0.0));
    let n010 = hash13(i + vec3<f32>(0.0, 1.0, 0.0));
    let n110 = hash13(i + vec3<f32>(1.0, 1.0, 0.0));
    let n001 = hash13(i + vec3<f32>(0.0, 0.0, 1.0));
    let n101 = hash13(i + vec3<f32>(1.0, 0.0, 1.0));
    let n011 = hash13(i + vec3<f32>(0.0, 1.0, 1.0));
    let n111 = hash13(i + vec3<f32>(1.0, 1.0, 1.0));
    let x00 = mix(n000, n100, s.x);
    let x10 = mix(n010, n110, s.x);
    let x01 = mix(n001, n101, s.x);
    let x11 = mix(n011, n111, s.x);
    return mix(mix(x00, x10, s.y), mix(x01, x11, s.y), s.z);
}

/// 雲の骨格。⚠ octave を減らすと綿になる。雲は自己相似だから雲に見える。
fn fbm3(p: vec3<f32>, oct: i32) -> f32 {
    var v = 0.0;
    var amp = 0.5;
    var q = p;
    for (var i = 0; i < oct; i = i + 1) {
        v = v + amp * vnoise3(q);
        q = q * 2.03;
        amp = amp * 0.5;
    }
    return v;
}


// ── 雷 ──────────────────────────────────────────────
//
// ⚠ 体積でしか描けない絵。スプライトを貼っても、**貼った絵は内側から光らない**。
//   雲塊の中に光源を置くと、その塊が中から発光して、周りの雲へ光が漏れて、
//   手前の雲が影になる。これが「雲の中の雷」で、板では絶対に出ない。
//
// ⚠ Rust に持たせないこと。天候が場所の関数なら、雷も場所から出る
//   （どちらが決めるかを分けると、雷が晴れの日に落ちる）。
//   ポートフォリオの流れ星が「区間ハッシュで決定的にランダム」なのと同じ手。

/// 雷の縄張り（m）。この四方に1つ、雷雲が居る。
const BOLT_CELL: f32 = 3400.0;
/// 稲妻の色。⚠ 純白にしないこと。放電は僅かに青い。
const BOLT_COL: vec3<f32> = vec3<f32>(0.74, 0.84, 1.00);

/// その点に届く雷の光。
fn bolt_light(p: vec3<f32>) -> vec3<f32> {
    let cell = floor(p.xz / BOLT_CELL);
    // この縄張りが嵐かどうか。⚠ 晴れの縄張りでは光らせないこと。
    let st = weather((cell + 0.5) * BOLT_CELL).z;
    if (st < 0.22) {
        return vec3<f32>(0.0);
    }
    let h = hash13(vec3<f32>(cell.x, 7.0, cell.y));
    let h2 = hash13(vec3<f32>(cell.x, 13.0, cell.y));

    // 発光。⚠ 一定の明滅にしないこと。稲妻は「バッ」と来て尾を引く。
    //   区間で区切って、区間ごとに落ちるか決める＝決定的なランダム。
    let period = 3.2 + h * 5.5;
    let k = fract(u.time / period + h2);
    // 立ち上がりは一瞬、減衰は指数。さらに細かく震わせる（多重放電）。
    var flash = exp(-k * 24.0);
    flash = flash * (0.55 + 0.45 * step(0.5, fract(k * 46.0 + h)));
    if (flash < 0.002) {
        return vec3<f32>(0.0);
    }

    // 発光点。雲の中ほどに置く。
    let bp = vec3<f32>(
        (cell.x + 0.2 + h * 0.6) * BOLT_CELL,
        1500.0 + h2 * 1500.0,
        (cell.y + 0.2 + h2 * 0.6) * BOLT_CELL,
    );
    let d = distance(p, bp);
    // ⚠ 減衰は逆二乗。線形にすると縄張りの端まで均一に光って、板になる。
    //   影は取らない（光線 march を足すと倍重い）。雲の濃い所は
    //   そこまで光が来る前に密度で食われるので、実用上は困らない。
    return BOLT_COL * flash * st * 5200.0 / (1.0 + d * d * 0.0035);
}

// ── 密度 ────────────────────────────────────────────

/// 天候。⚠ **時間の関数にしないこと。場所の関数にすること。**
///
/// 時間にすると「1分後に嵐」というレールになる。この session で4回落ちた穴と同じ：
/// 進行の持ち方が違うだけで、結局どこまで進んだかを数える site になる。
/// 場所なら、引き返せるし、順番が無いし、行き先も無い＝**一生飛べる**。
///
/// ⚠ 自分が昇り降りするのではなく、**世界の雲頂が上下する**。
///   高度を動かすと「よし上へ抜けるぞ」という操作になって、天候が背景に落ちる。
///   雲頂が動けば、同じ高度で飛んでいるだけで、抜けたり潜ったりする。
///
/// 戻り値 x=雲量 0..1 / y=雲頂（m）/ z=嵐の強さ 0..1
///
/// ⚠ スケールを大きく取ること。数十km で1つの天候。細かくすると
///   数秒ごとに晴れと嵐が入れ替わって、天候ではなく点滅になる。
fn weather(xz: vec2<f32>) -> vec3<f32> {
    // 1区画のおおよその幅。⚠ でかくしすぎないこと。
    //   57km にしていた時は、205m/s で横断に 4.6分＝天候が変わる前に飽きる。
    //   14km なら約70秒。手前の octave がその半分で効くので、30秒ごとに何か変わる。
    let q = xz * 0.000036;
    // ⚠ ここは 2 oct で足りる。天候は大きなうねりなので細部が要らない。
    //   density() から毎回呼ばれるので、重くすると全部に効く。
    //
    // ⚠ fbm3 は [0,1] にならない。amp の和が上限（2 oct なら 0.5+0.25=0.75、平均0.375）。
    //   これを [0,1] のつもりで閾値を置くと、雲頂が常に巡航高度より下＝
    //   一生雲海の上を飛ぶ空っぽの世界になる（実際そうなっていた）。
    let w = clamp(fbm3(vec3<f32>(q.x, 0.0, q.y) * 2.0, 2) / 0.75, 0.0, 1.0);

    // 嵐は稀であること。⚠ 常時嵐にすると嵐が普通になって、怖くなくなる。
    let storm = smoothstep(0.66, 0.90, w);
    // 雲量。⚠ 高めに保つ（雲海は隙間なく埋まった白い床）。ただし最低を下げすぎず
    //   下げなさすぎず：高すぎると縁が崖になり、低すぎると千切れ雲になる。
    let cover = mix(0.48, 1.0, smoothstep(0.18, 0.72, w));

    // 雲頂。⚠ 基本は逆転層でほぼ平ら。ここが雲海の全部。
    //   うねりは海面のうねり程度に留めること。
    let wave = (fbm3(vec3<f32>(xz.x * 0.00022, 5.0, xz.y * 0.00022), 2) / 0.75 - 0.5) * 2.0;
    var top = INVERSION + wave * INV_WAVE;
    // 積乱雲だけが蓋を破る。⚠ 全体を持ち上げないこと（それをやると山脈に戻る）。
    top = mix(top, TOWER_TOP, storm);
    return vec3<f32>(cover, top, storm);
}

/// どこに雲が在るか。⚠ 一様にすると地平まで一面の綿になる。
///   雲海が雲海に見えるのは、**切れ間と厚みの差**があるから。
fn coverage(xz: vec2<f32>, wcover: f32) -> f32 {
    let q = xz * 0.000055 + vec2<f32>(u.time * 0.0016, 0.0);
    var c = fbm3(vec3<f32>(q.x, 0.0, q.y) * 2.0, 3);
    // 塊を作る。⚠ smoothstep を掛けないと、密度が中間値だらけになって靄になる。
    //   閾値を天候で動かす＝晴れでは塊が痩せて、嵐では繋がる。
    // cover_bias は移植で追加した外部ノブ（+で曇り/-で晴れ）。閾値をずらす＝塊の太り方が変わる。
    let lo = clamp(mix(0.52, 0.16, wcover) - u.cover_bias * 0.30, 0.02, 0.95);
    c = smoothstep(lo, lo + 0.44, c);
    return c * wcover;
}

/// 上下の形。底は平ら、頂は膨らむ＝入道雲の輪郭。
/// ⚠ 上下で同じ形にすると、パンみたいな板が浮く。
/// 雲頂がどこまで届くか（h の割合）。⚠ **これが「厚み」の正体。**
///
/// 逆転層は硬い蓋だが、**蓋に届くかどうかは場所ごとに違う**。
/// 実際の層積雲の頂は、蓋に押し付けられた綿花の塊がぼこぼこ並んだ面で、
/// 塊の頭は蓋に触れ、間の谷は数百m下がっている。
///
/// ⚠ 高さだけで一律に切らないこと（`1.0 - smoothstep(0.84, 1.0, h)` にしていた）。
///   それは解析的な平面なので、どれだけ 3D ノイズを積んでも海面が板になる。
///   実測：骨格ノイズの最細オクターブは振幅±0.0625＝可視表面が±15m しか動かない
///   ＝300m 進んで 15m の起伏＝傾き3°＝平ら。「雲の厚みがなくない？」の原因。
const TOP_RELIEF: f32 = 0.24;
/// 塊の大きさ（1/m）。⚠ 大きくしすぎないこと。層積雲の塊は数百m。
const TOP_LUMP: f32 = 0.00095;

fn cloud_ceiling(xz: vec2<f32>) -> f32 {
    let b = fbm3(vec3<f32>(xz.x * TOP_LUMP, 11.0, xz.y * TOP_LUMP), 3) / 0.875;
    // b=1 → 蓋まで届く塊 / b=0 → 谷。
    return 1.0 - TOP_RELIEF * (1.0 - b);
}

fn height_profile(h: f32, cov: f32, ceil_h: f32) -> f32 {
    // 底：ふわっと立ち上がる。
    let bottom = smoothstep(0.0, 0.14, h);
    // ⚠ 雲量が薄い所（＝雲海の縁）は雲頂も沈めること。これをしないと、
    //   密度だけ薄い「垂直の薄壁」が縁に立って、雲海が崖で終わる（「不自然に消える」）。
    //   縁は傾斜して海へ沈むのが自然。cov でぼこぼこの蓋そのものを下げる。
    let ceil2 = ceil_h * mix(0.42, 1.0, smoothstep(0.5, 1.0, cov));
    // 頂：塊ごとの高さで切る。⚠ 硬すぎると雲頂すれすれから見た断面が「壁」になり、
    //   柔らかすぎると海面がぼやけて靄になる。中間で、上端に少し羽を残す。
    let top = 1.0 - smoothstep(ceil2 - 0.15, ceil2 + 0.03, h);
    return bottom * top;
}

/// その点の雲の濃さ。
fn density(p: vec3<f32>, detail: bool) -> f32 {
    // ⚠ 雲頂は場所ごとに違う。ここを定数にすると、天候が効かなくなる。
    let wx = weather(p.xz);
    let top = wx.y;
    let h = (p.y - Y0) / (top - Y0);
    if (h < 0.0 || h > 1.0) {
        return 0.0;
    }
    // 移植で翼端渦（航跡）を撤去。ここに飛行機は居ない。
    var d = 0.0;
    let cov = coverage(p.xz, wx.x);
    if (cov > 0.001) {
        // 風で流れる。⚠ 上と下で速さを変えること（同じだと板ごと平行移動する）。
        let wind = vec3<f32>(u.time * 12.0 * (0.6 + h * 0.8), 0.0, u.time * 3.0);
        d = fbm3((p + wind) * 0.00042, 4);
        d = d * height_profile(h, cov, cloud_ceiling(p.xz + wind.xz));
        // 切れ間。coverage が薄い所は雲を削る。
        d = d - (1.0 - cov) * 0.62;

        if (detail && d > 0.0) {
            // 縁を削る。⚠ ここが無いと輪郭が滑らかすぎて風船になる。
            //   底ほど強く削る＝ちぎれた雲片が下にぶら下がる。
            let er = fbm3((p + wind * 2.0) * 0.0034, 2);
            // 底ほど強く削る＝ちぎれた雲片が下にぶら下がる。
            d = d - er * 0.30 * (1.0 - smoothstep(0.0, 0.55, h));
            // ⚠ 全体にも掛けること。ここを弱くすると雲頂に凹凸を作る項が
            //   一つも無くなって（上の重みが h>0.55 で 0 になるので）、海面が磨いた板になる。
            //   雲頂の縁をちぎれさせる＝崖でなく、たなびいて薄れる縁になる。
            d = d - er * 0.32;
        }
        // 嵐ほど濃い＝光が奥まで届かなくなって、勝手に暗くなる。
        // ⚠ 嵐を「暗い色」で塗らないこと。濃さを上げれば Beer-Lambert が暗くする。
        d = d * (1.0 + wx.z * 1.5);
    }
    return clamp(d, 0.0, 1.0);
}

// ── 光 ──────────────────────────────────────────────

/// 太陽の向き。呼び元から受ける＝地上の陰影（方向光）と雲の光が同じ向きになる。
/// ★ここを内部で作ると、地面の影は右から・雲の銀縁は左から、という食い違いが必ず出る。
fn sun_dir() -> vec3<f32> {
    return normalize(u.sun.xyz);
}

/// Henyey-Greenstein 位相関数。`g` が前方散乱の強さ。
/// ⚠ 等方散乱にしないこと。太陽の方を向いた時に雲の縁が銀に光るのは、
///   光が前方へ強く散るから。これが雲の一番の見せ場。
fn hg(cos_a: f32, g: f32) -> f32 {
    let g2 = g * g;
    let d = 1.0 + g2 - 2.0 * g * cos_a;
    return (1.0 - g2) / (12.566370 * pow(max(d, 1e-4), 1.5));
}

/// 雲の縁が暗くなる効果。⚠ これが無いと綿菓子になる。
/// 薄い所ほど、実は光が入って散る前に抜けてしまうので暗い。
fn powder(d: f32) -> f32 {
    return 1.0 - exp(-d * 12.0);
}

/// 太陽へ向かって進み、そこまでの雲の厚みを測る。
/// ⚠ 歩幅を等間隔にしないこと。近くを細かく、遠くを粗く（指数）＝
///   同じ歩数で遠くまで届く。
fn light_march(p: vec3<f32>, sd: vec3<f32>) -> f32 {
    var sum = 0.0;
    var t = 0.0;
    for (var i = 0; i < 4; i = i + 1) {
        let step = 62.0 * pow(1.85, f32(i));
        let sp = p + sd * (t + step * 0.5);
        sum = sum + density(sp, false) * step;
        t = t + step;
    }
    return sum;
}

/// 空。⚠ 単色にしないこと。地平が明るくて天頂が濃いのが空。
fn sky(rd: vec3<f32>, sd: vec3<f32>) -> vec3<f32> {
    let up = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);
    let alt = clamp(u.sun_alt, -1.0, 1.0);
    // 昼の空 / 朝夕の空。太陽高度で混ぜる。
    let day_hi = vec3<f32>(0.075, 0.175, 0.420);
    let day_lo = vec3<f32>(0.400, 0.560, 0.760);
    let dusk_hi = vec3<f32>(0.045, 0.070, 0.185);
    let dusk_lo = vec3<f32>(0.760, 0.360, 0.190);
    let k = smoothstep(-0.10, 0.32, alt);
    let hi = mix(dusk_hi, day_hi, k);
    let lo = mix(dusk_lo, day_lo, k);
    var c = mix(lo, hi, pow(up, 0.62));

    // 太陽の周りの散乱。⚠ 円で描かないこと（貼った丸に見える）。
    let ca = max(dot(rd, sd), 0.0);
    c = c + vec3<f32>(1.00, 0.62, 0.32) * pow(ca, 7.0) * 0.55 * (0.35 + k);
    c = c + vec3<f32>(1.00, 0.86, 0.66) * pow(ca, 900.0) * 12.0;

    // 夜は星。⚠ 滑らかなグローにしないこと。星は粒。
    let night = smoothstep(0.06, -0.16, alt);
    if (night > 0.001) {
        let g = hash13(floor(rd * 620.0));
        let star = smoothstep(0.9975, 1.0, g) * smoothstep(-0.05, 0.25, rd.y);
        c = c + vec3<f32>(0.85, 0.90, 1.0) * star * night * 2.2;
    }
    return c;
}

/// 光線が雲の層と交わる区間。
fn slab(ro: vec3<f32>, rd: vec3<f32>) -> vec2<f32> {
    // ⚠ 真横を向くと rd.y が 0 になって発散する。
    if (abs(rd.y) < 1e-4) {
        if (ro.y > Y0 && ro.y < Y_MAX) {
            return vec2<f32>(0.0, FAR);
        }
        return vec2<f32>(-1.0, -1.0);
    }
    let inv = 1.0 / rd.y;
    var t0 = (Y0 - ro.y) * inv;
    var t1 = (Y_MAX - ro.y) * inv;
    if (t0 > t1) {
        let tmp = t0;
        t0 = t1;
        t1 = tmp;
    }
    return vec2<f32>(max(t0, 0.0), min(t1, FAR));
}

/// 視線。⚠ 2つのパスで必ず同じ式を使うこと。ずれると雲と機体が別の場所を向く。
struct Basis {
    fwd: vec3<f32>,
    rgt: vec3<f32>,
    up: vec3<f32>,
}

/// カメラの向き。呼び元が実カメラから作った基底をそのまま使う（yaw/pitch を組み直さない
/// ＝呼び元の座標系や上方向の取り方に依存しない）。
fn cam_basis() -> Basis {
    return Basis(normalize(u.fwd.xyz), normalize(u.rgt.xyz), normalize(u.up.xyz));
}

/// 画面 uv → 視線。⚠ 焦点距離 1.15 は呼び元の fov と合わせること（合わないと空だけ画角が違う）。
fn ray_dir(uv: vec2<f32>) -> vec3<f32> {
    let sp = vec2<f32>((uv.x - 0.5) * u.aspect, uv.y - 0.5);
    let b = cam_basis();
    return normalize(b.fwd * u.fwd.w + b.rgt * sp.x + b.up * sp.y);
}

fn cam_pos() -> vec3<f32> {
    return u.cam.xyz;
}

/// 雲のパス。⚠ **半解像度**で回る。25fps だった時の犯人はここ。
///   雲は元々ぼやけているので、半分の解像度で描いて拡大しても分からない。
///   代わりに、空と機体（＝輪郭が硬い物）はフル解像度の合成パスへ残す。
///
/// 出力は色ではなく `vec4(散乱, 透過率)`。
/// ⚠ ここで空を混ぜないこと。混ぜると空まで半解像度になって、
///   太陽の縁と機体のシルエットがギザギザになる。
@fragment
fn fs_cloud(in: VOut) -> @location(0) vec4<f32> {
    let rd = ray_dir(in.uv);
    let ro = cam_pos();
    let sd = sun_dir();

    // 移植で機体を撤去したので打ち切りは無し（雲は常に最遠まで）。
    let far_limit = FAR;

    var sl = slab(ro, rd);
    sl.y = min(sl.y, far_limit);
    if (sl.y > sl.x && sl.y > 0.0) {
        let cos_a = dot(rd, sd);
        // 位相関数。前方散乱＋僅かな後方散乱（雲は両方持つ）。
        let ph = mix(hg(cos_a, 0.72), hg(cos_a, -0.22), 0.24);

        // 太陽の色。低いほど赤い＝大気を長く通るので青が散って消える。
        let warm = smoothstep(0.42, -0.06, u.sun_alt);
        let sun_col = mix(vec3<f32>(1.00, 0.97, 0.92), vec3<f32>(1.00, 0.44, 0.16), warm)
                      * mix(1.0, 2.4, warm);
        // 空からの回り込み。⚠ これが無いと雲の底が真っ黒になる（実物の底は青い）。
        let amb_top = vec3<f32>(0.42, 0.55, 0.80);
        let amb_bot = vec3<f32>(0.10, 0.14, 0.24);

        // ⚠ 一様な歩幅で刻まないこと。**空の方が雲より遥かに広い**ので、
        //   何も無い所を細かく刻むのが一番の無駄。
        //   粗く進んで、雲に当たったら一歩戻って刻む（二段階 march）。
        //   ここを一様 84 等分にしていた時は「バカ重い」と言われた。
        // 縞消し。⚠ 開始オフセットは小さく。⚠ 大きく取ると、雲頂を掠めている時に
        //   目の前(数十m)の雲塊を1歩目で飛び越して「当たる前に消える」。
        //
        // ⚠ time を入れないこと。毎フレーム違うオフセット＝TAA が無いので時間的に
        //   均されず、TVの砂嵐のように雲がザラザラ動く。空間だけで散らす（静止する）。
        let dither = hash13(vec3<f32>(in.uv * 2048.0, 0.0));
        var t = sl.x + 8.0 * dither;

        var trans = 1.0;
        var scat = vec3<f32>(0.0);
        // 粗いか細かいか。雲を出たら粗いに戻る。
        var fine = false;
        var miss = 0;

        for (var i = 0; i < 160; i = i + 1) {
            if (t > sl.y || trans < 0.04) {
                break;
            }
            let p = ro + rd * t;

            if (!fine) {
                // 粗い側。⚠ ここが一番呼ばれる。detail も照明も触らないこと。
                // ⚠ 粗ステップも距離適応。固定 95m だと、雲頂を掠める時に目の前の
                //   雲塊を1歩で飛び越して「当たる前に消える」。近いほど小刻みに探す。
                let cstep = clamp(t * 0.045, 20.0, 260.0);
                if (density(p, false) > 0.0) {
                    // 半歩だけ戻る（可変ステップなので t-big のように全戻しできない）。
                    t = t - cstep * 0.5;
                    fine = true;
                    continue;
                }
                t = t + cstep;
                continue;
            }

            // ⚠ 距離適応。span 基準の固定刻みにすると、海面すれすれを飛んでいる時
            //   （視線が浅く、span が数km になる時）に、目の前の雲まで粗い刻みで
            //   サンプルして縁がガタつく＝「雲に近づくと画質が悪い」の主因。
            //   近い雲ほど画面で大きく細部が見えるので、近いほど細かく刻む。
            let dt = clamp(t * 0.016, 11.0, 72.0);
            let d = density(p, true);
            if (d <= 0.001) {
                miss = miss + 1;
                // 抜けた。⚠ すぐ粗くに戻さないこと（雲の隙間で毎回切り替わる）。
                if (miss > 8) {
                    fine = false;
                    miss = 0;
                }
                t = t + dt;
                continue;
            }
            miss = 0;
            {
                let ds = d * SIGMA;
                // 太陽までの厚み。
                let sun_d = light_march(p, sd);

                // 多重散乱。⚠ 1回散乱だけだと雲の底が黒く潰れる。
                //   octave ごとに、消散を弱く・位相を等方へ寄せる＝
                //   何度も散った光ほど、向きを忘れて奥まで届く、を近似する。
                var lum = vec3<f32>(0.0);
                var a = 1.0;
                var b = 1.0;
                var c2 = 1.0;
                for (var o = 0; o < 3; o = o + 1) {
                    let beer = exp(-sun_d * SIGMA * a);
                    let phase_o = mix(hg(cos_a, 0.72 * c2), hg(cos_a, -0.22 * c2), 0.24);
                    lum = lum + sun_col * beer * phase_o * b;
                    a = a * 0.42;
                    b = b * 0.58;
                    c2 = c2 * 0.60;
                }
                // powder。縁が暗くなる。
                lum = lum * (0.22 + 0.78 * powder(d));

                // 空の回り込み。上ほど空を見ている。
                let h = clamp((p.y - Y0) / (weather(p.xz).y - Y0), 0.0, 1.0);
                lum = lum + mix(amb_bot, amb_top, h) * 0.55;

                // 雷。⚠ ここで足すこと（雲の外で足すと、雲の手前に光の球が浮く）。
                //   密度のある所でだけ散る＝雲塊が内側から光る。
                lum = lum + bolt_light(p);

                // 透過率を積分する（Beer-Lambert）。
                let ext = exp(-ds * dt);
                // ⚠ `lum * ds * dt * trans` と書かないこと。歩幅が変わると明るさが変わる。
                //   区間内で解析的に積分した形にすれば、歩幅に依らない。
                scat = scat + trans * (1.0 - ext) * lum;
                trans = trans * ext;
            }
            t = t + dt;
        }

        return vec4<f32>(scat, trans);
    }
    // 雲に当たらない＝素通し。
    return vec4<f32>(0.0, 0.0, 0.0, 1.0);
}

// ── 合成（フル解像度）────────────────────────────────

@group(1) @binding(0) var cloud_tex: texture_2d<f32>;
@group(1) @binding(1) var cloud_smp: sampler;

/// 空と機体をフル解像度で描いて、半解像度の雲を上に重ねる。
///
/// ⚠ `sky * trans + scat` の順を守ること。雲は空の**手前**に在るので、
///   空を透過率で減らしてから散乱を足す。逆にすると雲が透ける。
@fragment
fn fs_bg(in: VOut) -> @location(0) vec4<f32> {
    let rd = ray_dir(in.uv);
    let ro = cam_pos();
    let sd = sun_dir();

    var col = sky(rd, sd);

    // 雲。bilinear で拡大する＝元がぼやけているので繋ぎ目は出ない。
    //
    // ⚠ v を反転すること。`vs_bg` の uv は NDC 由来なので**画面の上が uv.y=1.0**、
    //   一方 wgpu のテクスチャは **v=0 が上の行**。そのまま読むと雲だけが上下逆になり、
    //   空と機体（uv から直接計算している）は正しいまま＝「空は合ってるのに
    //   雲海が空に浮いている」という絵になる。2パスに分けた時に入った。
    let c = textureSample(cloud_tex, cloud_smp, vec2<f32>(in.uv.x, 1.0 - in.uv.y));
    col = col * c.a + c.rgb;

    // ★トーンマップは**しない**。線形HDRのまま出して、seimei のポストプロセスに一括で任せる。
    //   ここで ACES を掛けると合成側と二重処理になり、空が白く飛んでシーンと階調が合わなくなる。
    //   露出だけ僅かに乗せる（シーンのライト強度と釣り合わせるノブ）。
    col = col * 1.05;

    return vec4<f32>(col, 1.0);
}
